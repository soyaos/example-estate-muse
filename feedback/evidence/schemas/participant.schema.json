{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soyaos.ai/schemas/estate-muse-participant.v2.json",
  "title": "EstateMuse anonymous owner self-trial evidence (scope decided 2026-09-09)",
  "type": "object",
  "required": [
    "schema_version",
    "trial_scope",
    "scope_decided_on",
    "participant_id",
    "profile",
    "trial_started_on",
    "trial_ended_on",
    "attestation",
    "opaque_evidence_ids",
    "sessions",
    "quality_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "estate-muse-participant.v2"},
    "trial_scope": {"const": "owner_self_trial"},
    "scope_decided_on": {"const": "2026-09-09"},
    "participant_id": {"const": "EM-01"},
    "profile": {
      "enum": ["本人真实需求试用", "公众号作者", "视频号作者", "小红书作者", "抖音作者", "经纪公司内容运营", "房产内容编辑"]
    },
    "trial_started_on": {"type": "string", "format": "date"},
    "trial_ended_on": {"type": "string", "format": "date"},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real_human", "project_owner", "real_personal_need", "fourteen_day_trial_consented", "anonymous_feedback_confirmed", "owner_confirmed", "verified_on"],
      "properties": {
        "real_human": {"const": true},
        "project_owner": {"const": true},
        "real_personal_need": {"const": true},
        "fourteen_day_trial_consented": {"const": true},
        "anonymous_feedback_confirmed": {"const": true},
        "owner_confirmed": {"const": true},
        "verified_on": {"type": "string", "format": "date"}
      }
    },
    "opaque_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^EV-[A-Z0-9][A-Z0-9-]{5,63}$"}
    },
    "sessions": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/session"}
    },
    "quality_summary": {"$ref": "#/$defs/quality"}
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "occurred_on", "target_platform", "actions"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^EM-01-S\\d{2,3}$"},
        "occurred_on": {"type": "string", "format": "date"},
        "target_platform": {"enum": ["公众号", "视频号", "小红书", "抖音", "其他"]},
        "xlsx": {"$ref": "#/$defs/xlsx"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "xlsx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "duration_ms", "desktop_app", "opened", "edited_successfully", "chinese_ok", "filters_ok", "freeze_header_ok"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 500},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
        "desktop_app": {"enum": ["Microsoft Excel", "WPS", "Apple Numbers", "LibreOffice", "其他"]},
        "opened": {"const": true},
        "edited_successfully": {"const": true},
        "chinese_ok": {"const": true},
        "filters_ok": {"const": true},
        "freeze_header_ok": {"const": true}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "row_ref", "duration_ms", "success", "used_persisted_row"],
      "properties": {
        "action": {"enum": ["generate_post", "generate_video"]},
        "row_ref": {"type": "string", "pattern": "^(row-[A-Za-z0-9_-]{1,64}|sha256:[0-9a-f]{64})$"},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "success": {"const": true},
        "used_persisted_row": {"const": true}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampled_rows", "grade_counts", "duplicate_groups_count", "omitted_angles_count", "originality_samples", "originality_warning_accurate_count", "originality_false_positive_count", "originality_false_negative_count", "final_outcome", "confirmed_anonymous_quote"],
      "properties": {
        "sampled_rows": {"type": "integer", "minimum": 1},
        "grade_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C"],
          "properties": {
            "A": {"type": "integer", "minimum": 0},
            "B": {"type": "integer", "minimum": 0},
            "C": {"type": "integer", "minimum": 0}
          }
        },
        "duplicate_groups_count": {"type": "integer", "minimum": 0},
        "omitted_angles_count": {"type": "integer", "minimum": 0},
        "originality_samples": {"type": "integer", "minimum": 1},
        "originality_warning_accurate_count": {"type": "integer", "minimum": 0},
        "originality_false_positive_count": {"type": "integer", "minimum": 0},
        "originality_false_negative_count": {"type": "integer", "minimum": 0},
        "final_outcome": {"enum": ["继续使用", "修改后使用", "不会使用"]},
        "confirmed_anonymous_quote": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    }
  }
}
